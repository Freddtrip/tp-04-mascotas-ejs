<!-- Muestra como título el nombre de la mascota recibida desde la ruta -->
<h1><%= mascota.nombre %></h1>

<!-- Muestra la imagen indicada en el JSON y utiliza el nombre de la mascota como descripción -->
 <!-- Muestra la imagen indicada en el JSON con un ancho de 300 píxeles -->
<img
class="imagen-mascota"
    src="<%= mascota.imagen %>"
    alt="Imagen de <%= mascota.nombre %>"

>
<!-- Muestra todos los datos de la mascota seleccionada -->
<p>Especie: <%= mascota.especie %></p>
<p>Edad: <%= mascota.edad %> años</p>
<p>Descripción: <%= mascota.descripcion %></p>
<p>Estado: <%= mascota.estado %></p>



<!-- Permite regresar desde el detalle al catálogo completo -->
<a class="boton" href="/mascotas">Volver al catálogo</a>